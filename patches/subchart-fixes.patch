+        if (res.status !== 200) { return false; }
+        try {
+          const body = JSON.parse(res.data);
+          return !!(body.tokens && body.tokens['{{ template "kibana.fullname" . }}']);
+        } catch (e) {
+          return false;
+        }
+      });
+    }
