+    // elk8-dev patch: like requestPromise but resolves {status, data} for any HTTP status
+    function requestStatus(url, httpsOptions) {
+      return new Promise((resolve, reject) => {
+        const request = https.request(url, httpsOptions, response => {
+          let data = '';
+          response.on('data', chunk => data += chunk);
+          response.once('end', () => resolve({status: response.statusCode, data: data}));
+        });
+        request.once('error', err => {
+          console.log(`${httpsOptions.method} ${url} failed: `, err.message || err);
+          reject(err);
+        });
+        request.end();
+      });
+    }
+
+    function k8sSecretExists() {
