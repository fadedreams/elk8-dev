diff --git a/charts/elasticsearch/templates/secret.yaml b/charts/elasticsearch/templates/secret.yaml
index cbdcbba..5c3952f 100644
--- a/charts/elasticsearch/templates/secret.yaml
+++ b/charts/elasticsearch/templates/secret.yaml
@@ -1,5 +1,8 @@
 {{- if .Values.secret.enabled -}}
 {{- $passwordValue := (randAlphaNum 16) | b64enc | quote }}
+{{- /* elk8-dev patch: reuse the password of an existing secret so helm upgrade does not rotate it
+       (ES only reads it at pod start, so a rotated secret would no longer match the running node). */ -}}
+{{- $existing := lookup "v1" "Secret" .Release.Namespace (printf "%s-credentials" (include "elasticsearch.uname" .)) }}
 apiVersion: v1
 kind: Secret
 metadata:
@@ -17,6 +20,8 @@ data:
   username: {{ "elastic" | b64enc }}
   {{- if .Values.secret.password }}
   password: {{ .Values.secret.password | b64enc }}
+  {{- else if and $existing $existing.data (hasKey $existing.data "password") }}
+  password: {{ index $existing.data "password" | quote }}
   {{- else }}
   password: {{ $passwordValue }}
   {{- end }}
